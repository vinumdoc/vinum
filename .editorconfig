root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_lenght = 100

[*.{c,h}]
indent_style = tab
indent_size = tab
tab_width = 8

[*.md]
indent_style = space
indent_size = 4
max_line_lenght = 80

[*.build]
indent_style = space
indent_size = 2
